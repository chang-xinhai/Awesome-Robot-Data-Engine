---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogCard from "../components/CatalogCard.astro";
import { getCatalog, SOURCES } from "../lib/catalog";
import { SITE } from "../lib/site";
import { sitePath } from "../lib/paths";
const works = getCatalog();
const visual = works.filter((w) => w.image);
const first = visual.slice(0, 12);
const years = [...new Set(works.map((w) => w.year))].sort().reverse();
const types = [...new Set(works.map((w) => w.resourceType))].sort();
const stages = [...new Set(works.map((w) => w.stage))].sort();
const signals = [...new Set(works.flatMap((w) => w.signals))].filter((s) => s !== "Not reported").sort();
const initial = ["2403.12945", "2310.08864", "2402.10329", "2311.18259", "2310.17596", "2309.16759"];
const icon = {
  search: "M21 21l-4.35-4.35M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z",
  filter: "M4 7h16M7 12h10M10 17h4",
  chevron: "m6 9 6 6 6-6",
  close: "m6 6 12 12M6 18 18 6",
  share: "M12 16V3m-4 4 4-4 4 4M5 12v8h14v-8",
};
---

<BaseLayout
  title="Awesome Robot Data Engine — Datasets & data systems"
  description={SITE.description}
>
  <section class="library-intro wrap">
    <h1><span>Better data.</span>{" "}<span>More capable robots.</span></h1>
    <p>
      A living atlas of datasets and data engines for robot learning.
    </p>
  </section>
  <section class="library wrap" id="library" aria-label="Research library">
    <nav class="source-tabs" aria-label="Data sources">
      <button type="button" data-source="all" aria-pressed="true">All sources <span>{works.length}</span></button>
      {SOURCES.map((s) => <button type="button" data-source={s.key} aria-pressed="false" title={works.filter((w) => w.sourceKey === s.key).length + " research works"}>{s.label}<span>{works.filter((w) => w.sourceKey === s.key).length}</span></button>)}
    </nav>
    <p class="source-description" id="source-description">Five perspectives. From experience to useful training data.</p>
    <div class="library-toolbar" id="library-toolbar">
      <div class="library-tabs" role="group" aria-label="Display">
        <button type="button" data-collection="visual" aria-pressed="true">Visual atlas</button>
        <button type="button" data-collection="research" aria-pressed="false">All research</button>
      </div>
      <label class="search-field">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={icon.search} />
        </svg>
        <input
          id="catalog-search"
          type="search"
          autocomplete="off"
          placeholder="Find a dataset, engine, modality, or institution…"
          aria-label="Search the library"
        />
        <kbd>/</kbd>
      </label>
      <button
        class="filters-toggle"
        id="filters-toggle"
        aria-label="Filters"
        aria-expanded="false"
        aria-controls="filter-panel"
        type="button"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={icon.filter} />
        </svg>
        <span>Filters</span>
        <span class="filter-count" id="filter-count" hidden>
          0
        </span>
      </button>
      <div class="filter-panel" id="filter-panel" hidden>
        <div class="filter-heading">
          <h2>Refine your collection</h2>
          <button id="reset-filters" type="button">
            Reset
          </button>
        </div>
        <div class="filter-fields">
          <label>Data collection
            <select id="source-select"><option value="all">All sources</option>{SOURCES.map(s => <option value={s.key}>{s.label}</option>)}</select>
          </label>
          <label>Resource type
            <select id="type-filter"><option value="all">All resources</option>{types.map(v => <option value={v}>{v}</option>)}</select>
          </label>
          <label>Pipeline stage
            <select id="stage-filter"><option value="all">All stages</option>{stages.map(v => <option value={v}>{v}</option>)}</select>
          </label>
          <label>Available links
            <select id="access-filter"><option value="all">All resources</option><option value="data">Dataset linked</option><option value="code">Code linked</option><option value="both">Data &amp; code linked</option></select>
          </label>
          <label>Paper / resource year
            <select id="year-filter"><option value="all">All years</option>{years.map(v => <option value={v}>{v}</option>)}</select>
          </label>
        </div>
        <fieldset class="signal-filters">
          <legend>Signals &amp; labels</legend>
          {signals.map(v => <label><input type="checkbox" name="signal" value={v}/><span>{v}</span></label>)}
        </fieldset>
        <p class="filter-note">Links do not imply an open license. Signals and labels can include recovered state; simulator channels are configurable outputs, not necessarily released data or policy inputs.</p>
        <button type="button" id="apply-filters" class="button-dark">
          Done
        </button>
      </div>
    </div>
    <div class="library-meta">
      <p id="result-count" role="status" aria-live="polite">
        {visual.length} visual entries · {works.length} research works
      </p>
      <div class="library-meta-actions">
        <button type="button" id="share-view" aria-label="Copy this view link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icon.share} />
          </svg>
          <span>Share view</span>
        </button>
        <label class="sort-label">
          <span>Sort:</span>
          <select id="sort-order" aria-label="Sort results">
            <option value="newest" selected>Newest</option>
            <option value="oldest">Oldest</option>
            <option value="name">Name A–Z</option>
            <option value="recommended">Curated</option>
          </select>
        </label>
      </div>
    </div>
    <div
      class="active-filters"
      id="active-filters"
      aria-label="Active filters"
    ></div>
    <div id="catalog-results" class="catalog-feed" aria-busy="false">
      <div class="feed-batch">
        {first.map((w) => w && <CatalogCard work={w} />)}
      </div>
    </div>
    <div id="catalog-empty" class="empty-state" hidden>
      <h2>No matches this time.</h2>
      <p>Try another phrase or use fewer filters.</p>
      <button type="button" id="empty-reset" class="button-dark">
        Clear filters
      </button>
    </div>
    <div class="feed-boundary" id="feed-boundary">
      <div
        class="loading-dots"
        id="loading-dots"
        role="status"
        aria-label="Loading more entries"
        hidden
      >
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span id="feed-end" hidden>
        end
      </span>
      <div id="feed-error" hidden>
        <p>The collection could not be loaded.</p>
        <button type="button" id="retry-load">
          Try again
        </button>
      </div>
    </div>
    <noscript>
      <p class="no-script">
        For the complete collection,{" "}
        <a href={SITE.github + "#readme"}>read the README</a>. Search,
        comparison, and continuous loading require JavaScript.
      </p>
    </noscript>
  </section>
  <div class="compare-tray" id="compare-tray" hidden>
    <div>
      <strong id="compare-count">0 selected</strong>
      <span id="compare-names"></span>
    </div>
    <button type="button" id="open-compare" class="button-dark" disabled>
      Compare
    </button>
    <button
      type="button"
      id="clear-compare"
      class="icon-button"
      aria-label="Clear comparison"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
  </div>
  <dialog id="detail-dialog" class="detail-dialog">
    <button
      type="button"
      class="dialog-close icon-button"
      data-close
      aria-label="Close details"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
    <div id="detail-content"></div>
  </dialog>
  <dialog id="compare-dialog" class="compare-dialog">
    <button
      type="button"
      class="dialog-close icon-button"
      data-close
      aria-label="Close comparison"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
    <div id="compare-content"></div>
  </dialog>
  <dialog id="about-dialog" class="about-dialog">
    <button
      type="button"
      class="dialog-close icon-button"
      data-close
      aria-label="Close about"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
    <h2>A clearer view of robot data.</h2>
    <p>Explore robot-centric, UMI, egocentric, simulated, and general data resources in one collection.</p>
    <p>The README is the canonical bibliography. The visual atlas adds figures and concise facts from papers, official project pages, and documentation. Images belong to their credited projects.</p>
    <p>Reported scale and available releases can differ. Missing specifications remain unknown. Each detail view links back to its sources.</p>
    <a class="button-dark" href={SITE.github + "#readme"}>
      Read the collection ↗
    </a>
  </dialog>
  <p id="announcement" class="toast" role="status" aria-live="polite"></p>
  <script
    is:inline
    id="catalog-settings"
    type="application/json"
    set:html={JSON.stringify({
      initial,
      sources: SOURCES,
      base: import.meta.env.BASE_URL,
      endpoint: sitePath("catalog.json"),
      github: SITE.github,
    })}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: SITE.name,
      description: SITE.description,
      numberOfItems: works.length,
    })}
  />
  <script>
    import "../scripts/atlas";
  </script>
</BaseLayout>
