---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDailyArchive, getDataAssetFiles } from "../../lib/data";
import { sitePath } from "../../lib/paths";
import { SITE } from "../../lib/site";
const daily = getDailyArchive();
const assetFiles = getDataAssetFiles();
const groups = [
  { key: "robot-centric" as const, label: "Robot-centric Data", file: "robot-centric.md" },
  { key: "umi" as const, label: "UMI Data", file: "umi.md" },
  { key: "human-egocentric" as const, label: "Egocentric Data", file: "human-egocentric.md" },
  { key: "simulation" as const, label: "Simulation Data", file: "simulation.md" },
];
---
<BaseLayout title="Sources — Awesome Robot Data Engine" description="Primary-source curation and the separate discovery archive.">
  <div class="sources-page wrap">
    <a class="back-link" href={sitePath()}>← Back to the library</a>
    <h1>Follow the evidence.</h1>
    <p class="sources-deck">The visual atlas follows the curated README. The discovery archive keeps new candidates available for review.</p>
    <section>
      <h2>Primary sources first.</h2>
      <p>Paper records establish titles and first publication dates. Official projects, documentation, repositories, and dataset cards establish release details. Figures link to their original projects; third-party images retain their owners’ terms.</p>
      <a href={SITE.github + "#readme"}>Read the canonical collection ↗</a>
    </section>
    <section>
      <h2>Discovery archive</h2>
      <p>{daily.total.toLocaleString("en")} arXiv candidates. Latest paper date: {daily.latestPublished}. Archive entries are reviewed before entering the curated collection.</p>
      <div class="source-links">{groups.map(g => <a href={`${SITE.github}/blob/main/arXiv_daily/sections/${g.file}`}><span>{g.label}</span><span>{daily.counts[g.key].toLocaleString("en")} candidates ↗</span></a>)}</div>
    </section>
    {assetFiles.length > 0 && <section><h2>External data releases</h2><p>Manually maintained notes for releases outside the paper archive.</p><div class="source-links">{assetFiles.map(f => <a href={`${SITE.github}/blob/main/${f.relativePath}`}><span>{f.name}</span><span>View notes ↗</span></a>)}</div></section>}
  </div>
</BaseLayout>
<style>
.sources-page{max-width:53.125rem;padding-block:3.125rem 5.625rem}.back-link{font-size:0.75rem;color:var(--muted)}h1{font-family:"Source Serif 4",Georgia,serif;font-weight:450;font-size:clamp(2.5rem,5vw,3.75rem);letter-spacing:-.03em;margin:1.75rem 0 1rem}.sources-deck{font-size:1.0625rem;line-height:1.7;color:var(--muted);max-width:38.75rem}section{margin-top:2.875rem;padding-top:1.875rem;border-top:0.0625rem solid var(--line)}h2{font-size:1.375rem;font-weight:550;letter-spacing:-0.03125rem}section p{font-size:0.875rem;line-height:1.8;color:var(--muted);margin:0.875rem 0 1.25rem}section>a{font-size:0.8125rem;text-decoration:underline;text-underline-offset:0.25rem}.source-links{display:grid;gap:0}.source-links a{display:flex;justify-content:space-between;gap:1.25rem;padding:1.125rem 0;border-bottom:0.0625rem solid var(--line);font-size:0.8125rem}.source-links a span:last-child{color:var(--muted);font-size:0.75rem;white-space:nowrap}.source-links a:hover{color:#111}@media(max-width:600px){.sources-page{padding-top:1.5rem}.source-links a{flex-direction:column;gap:0.375rem}}
</style>
